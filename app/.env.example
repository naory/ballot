# Hedera testnet credentials
NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_HEDERA_OPERATOR_ID=0.0.XXXXX
HEDERA_OPERATOR_KEY=302e...

# Indexer GraphQL endpoint
NEXT_PUBLIC_INDEXER_URL=http://localhost:4000/graphql

# Mirror Node REST base URL
NEXT_PUBLIC_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# HCS registry topic for identity-commitment registration (F1/F2)
# Voters publish their commitment here once; the indexer indexes registrations.
# Set the same value as REGISTRY_TOPIC_ID on the indexer process.
NEXT_PUBLIC_REGISTRY_TOPIC_ID=0.0.XXXXX
